# Copy to .env and fill. Never commit real keys.

# At least one model key is required for the live TrueForge path.
# Replay mode (`/?play=1`) needs none of these.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: TrueForge-native Daytona sandbox. Without it, the agent still
# runs diagnostics in the Harbor Pay MCP isolate (no network, no fs, 8s cap).
DAYTONA_API_KEY=

TRUEFORGE_BASE_URL=http://127.0.0.1:8790
MCP_PORT=8791
NEXT_PUBLIC_APP_ORIGIN=http://127.0.0.1:3057
